# Supabase project settings — find these in
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth credentials are configured in the Supabase Dashboard
# (Authentication -> Providers -> Google), not in this app.
# See docs/GOOGLE_AUTH_SETUP.md for the full setup guide.

# Server-side only: powers AI document analysis via Anthropic Claude
# (never exposed to the browser).
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Optional: DeepSeek fallback for chat when Claude is rate-limited or down.
# Uses the OpenAI-compatible API at api.deepseek.com (Ask Gideon, document chat, research).
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Use DeepSeek for all chat (skips Claude for Ask Gideon when true):
# DEEPSEEK_CHAT_PRIMARY=true
# Optional: Claude model overrides (defaults below)
# CLAUDE_MODEL=claude-sonnet-4-5
# CLAUDE_VISUAL_MODEL=claude-sonnet-4-5
# Ask Gideon / chat / research (cheaper default)
# CLAUDE_CHAT_MODEL=claude-haiku-4-5

# Optional: not required for Trello — users paste API key + token in
# Settings → Connections. Do not commit real Trello tokens.
# TRELLO_API_KEY=
# TRELLO_TOKEN=

# Google Drive connector (Settings → Connections). Reuse the same Google Cloud
# OAuth web client as sign-in, or create a dedicated one. Enable the Google
# Drive API, add drive.readonly on the consent screen, and add these redirect
# URIs to the OAuth client:
#   http://localhost:3000/api/connections/google-drive/callback
#   https://guardian.nm2tech.com/api/connections/google-drive/callback
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=

# Server-side only: live web search for the Research section (tavily.com).
# Without this, /research returns a configuration error.
# TAVILY_API_KEY=tvly-your-tavily-api-key

# Optional: SAM.gov Entity Management + Opportunities APIs for Guardian Leads
# research. Without this, UEI/CAGE/certifications/opportunities stay unverified
# and Guardian will not invent them. USASpending.gov is still queried.
# SAM_GOV_API_KEY=your-sam-gov-api-key

# Server-side only — DANGER: bypasses Row Level Security. Used by the
# account deletion API (after verifying the caller's session) and the daily
# reminder cron. Never expose it to the browser or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: second Supabase project for company timesheets (Ask Gideon:
# "How many hours did Frank Damico work in May 2026?"). Tables expected:
# timesheet_users(id, name), timesheet_time_entries(user_id, date, hours).
# Prefer the service role for server reads; anon works if RLS allows it.
# TIMESHEET_SUPABASE_URL=https://your-timesheet-project.supabase.co
# TIMESHEET_SUPABASE_SERVICE_ROLE_KEY=your-timesheet-service-role-key
# TIMESHEET_SUPABASE_ANON_KEY=your-timesheet-anon-key

# Server-side only: sends deadline reminder emails via Resend (resend.com).
# Without a verified domain, Resend only delivers to your own account email
# and sends from onboarding@resend.dev.
RESEND_API_KEY=re-your-resend-api-key
# Optional: custom sender once your domain is verified in Resend.
# REMINDER_FROM_EMAIL=Guardian <reminders@yourdomain.com>
# Optional: sender for welcome / getting-started emails (defaults to REMINDER_FROM_EMAIL).
# TIPS_FROM_EMAIL=Guardian <hello@yourdomain.com>

# Generate keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.com

# Optional SMS via Twilio — disabled until SMS_NOTIFICATIONS_ENABLED=true.
# SMS_NOTIFICATIONS_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567

# Shared secret protecting /api/cron/* jobs. Vercel Cron sends it
# automatically as "Authorization: Bearer <value>" when this env var exists.
# Generate any long random string.
CRON_SECRET=your-long-random-secret

# Optional: comma-separated emails that can open /settings/usage (AI token
# totals). Empty = nobody. Example: ADMIN_EMAILS=you@example.com
# ADMIN_EMAILS=

# Guardian Simple Home (simple_home_v1) feature flag:
# disabled | admin-only | beta | enabled
# GUARDIAN_SIMPLE_HOME_FLAG=enabled

# disabled | admin-only | beta | enabled
# GUARDIAN_EXPERTS_FLAG=disabled

# Guardian Knowledge Engine (shadow mode): derives entities, memories, timeline
# events, and relationships after document analysis or Daily Log saves.
# No database writes in shadow mode. Defaults to disabled.
# GUARDIAN_KNOWLEDGE_ENGINE_ENABLED=false
# GUARDIAN_KNOWLEDGE_ENGINE_V2_ENABLED=false
# GUARDIAN_KNOWLEDGE_AUTO_SAVE_THRESHOLD=0.9
# GUARDIAN_KNOWLEDGE_SUGGEST_THRESHOLD=0.7
# GUARDIAN_KNOWLEDGE_DIAGNOSTICS=false

# Async document processing (upload → analyze → index → ontology → knowledge)
# DOCUMENT_PROCESSING_CONCURRENCY=2
# GUARDIAN_PROCESSING_DIAGNOSTICS=false

# Guardian Ontology Engine Phase 1
# GUARDIAN_ONTOLOGY_ENABLED=false
# GUARDIAN_ONTOLOGY_DIAGNOSTICS=false
# GUARDIAN_ONTOLOGY_FUZZY_THRESHOLD=0.92

# Guardian Semantic Layer Phase 1
# GUARDIAN_SEMANTIC_LAYER_ENABLED=false
# GUARDIAN_SEMANTIC_DIAGNOSTICS=false
# GUARDIAN_SEMANTIC_CONFIDENCE_THRESHOLD=0.75
# GUARDIAN_SEMANTIC_FUZZY_THRESHOLD=0.92
# GUARDIAN_SEMANTIC_DEADLINE_HORIZON_DAYS=14
# GUARDIAN_SEMANTIC_FOLLOWUP_QUIET_DAYS=45
# Auto-queue semantic backfill from document-processing cron (default on when layer enabled)
# GUARDIAN_SEMANTIC_AUTO_BACKFILL=true

# Stripe billing (Personal $12/mo). Checkout creates the product/price inline
# unless you set STRIPE_PRICE_PERSONAL. Webhook endpoint:
# POST https://guardian.nm2tech.com/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.*
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: saved Price IDs (skips inline price_data per plan)
# STRIPE_PRICE_PERSONAL=price_...
# STRIPE_PRICE_FAMILY=price_...
# STRIPE_PRICE_BUSINESS=price_...
# Optional: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Optional canonical app URL for Checkout return links
# NEXT_PUBLIC_APP_URL=https://guardian.nm2tech.com

# Database backups (scripts/backup-supabase.*) — never commit the real value.
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
# See docs/DATABASE_BACKUPS.md for scheduling daily backups.
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
# BACKUP_RETENTION_DAYS=30

# Optional: include extraction diagnostic payload in /api/documents/analyze
# responses (never logs full document text to the server console).
# GUARDIAN_ANALYSIS_DEBUG=1

# Optional: dedicated key for encrypting typed SSN in contractor intake (32-byte hex recommended).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# INTAKE_ENCRYPTION_KEY=

# Optional: browser + server error reporting via Sentry (sentry.io).
# Free tier: 5k errors/month. Create a project at sentry.io, copy the DSN.
# Without this, the app runs normally and simply does not report errors.
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# Optional: product analytics via PostHog (posthog.com).
# Free tier: 1M events/month. Tracks page views and elements with
# data-analytics="event_name" (e.g. data-analytics="nav_ask_gideon").
# Without this, analytics is a no-op and the app runs normally.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-api-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
